# Livestock Registry — local development environment configuration example.
#
# Usage:
#   cp local/.env.example local/.env
#   docker compose --env-file local/.env up -d --build
#
# Ports baked into local/keycloak/realm-staff.json and local/iam/login_providers.json:
#   STAFF_UI_PORT=3000, IAM_PORT=8000, KEYCLOAK_PORT=8080.
# If you change these ports, update those JSON files to match.

# ── Release & Versioning ──────────────────────────────────────────────────────
RELEASE_NAME=livestock
RP_VERSION=1.2.2-rc.544

# ── Domain & Cookies ─────────────────────────────────────────────────────────
COOKIE_DOMAIN=localtest.me

# ── Service Hosts & Ports ────────────────────────────────────────────────────
STAFF_UI_HOST=portal.localtest.me
STAFF_UI_PORT=3000

DASHBOARD_UI_HOST=dashboard.localtest.me
DASHBOARD_UI_PORT=3001

STAFF_API_PORT=8001
PARTNER_API_PORT=8002

KEYCLOAK_HOST=keycloak.localtest.me
KEYCLOAK_PORT=8080

IAM_HOST=iam.localtest.me
IAM_PORT=8000

MASTER_DATA_PORT=8010

MINIO_HOST=minio.localtest.me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_PORT=55432
POSTGRES_PASSWORD=postgres

# ── External Base Images ─────────────────────────────────────────────────────
IAM_IMAGE=openg2p/iam-staff-portal-api:1.4.0
MASTER_DATA_IMAGE=openg2p/master-data-api:1.1.0
IDGEN_IMAGE=openg2p/openg2p-id-generator:1.1.2

# ── Keycloak Configuration ───────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=staff
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass

# ── IAM Configuration ────────────────────────────────────────────────────────
IAM_DB=iam
IAM_DB_USER=iam_user
IAM_DB_PASSWORD=iam_pass
IAM_CLIENT_SECRET=staff-portal-secret

# ── Auth & OpenID Connect Client ─────────────────────────────────────────────
AUTH_CLIENT_ID=livestock-staff-portal
AUTH_CLIENT_SECRET=livestock-staff-portal-secret

# ── Master Data Database ─────────────────────────────────────────────────────
MASTER_DATA_DB=master_data
MASTER_DATA_DB_USER=master_data_user
MASTER_DATA_DB_PASSWORD=master_data_pass

# ── ID Generator Database ────────────────────────────────────────────────────
IDGEN_DB=livestock_idgenerator
IDGEN_DB_USER=livestock_idgenerator_user
IDGEN_DB_PASSWORD=livestock_idgenerator_pass

# ── Registry Database ────────────────────────────────────────────────────────
REGISTRY_DB=livestock
REGISTRY_DB_USER=livestock_user
REGISTRY_DB_PASSWORD=livestock_pass

# ── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DEFAULT_BUCKET=default
TEMPLATE_BUCKET=templates
DOCUMENTS_BUCKET=documents

# ── DB Seed Options ──────────────────────────────────────────────────────────
LOAD_GEO_DATA=false
LOAD_SAMPLE_DATA=false
LOAD_IMAGES=true
LOAD_TEMPLATES=true

# ── Disabled Integrations (Local Standalone) ─────────────────────────────────
AWE_ENABLED=false
AUDIT_ENABLED=false
PARTNER_SIGNATURE_VALIDATION_ENABLED=false
CONSENT_ENFORCEMENT_ENABLED=false
KEYMANAGER_AUTH_ENABLED=false
CRYPTO_BACKEND=local

# ── Approver Resolver & AWE ──────────────────────────────────────────────────
AWE_CALLBACK_SECRET_ID=awe-secret-id
AWE_CALLBACK_HMAC_SECRET=awe-hmac-secret
APPROVER_RESOLVER_SECRET=approver-resolver-secret

# ── Connector Service ────────────────────────────────────────────────────────
CONNECTOR_PORT=8051
CONNECTOR_UI_PORT=5174
CONNECTOR_DB=connector
CONNECTOR_DB_USER=connector_user
CONNECTOR_DB_PASSWORD=connector_pass
